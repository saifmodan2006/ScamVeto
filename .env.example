# Required for AI analysis. Choose a structured-output model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional reputation lookup; missing means no live threat-list lookup.
GOOGLE_WEB_RISK_API_KEY=
# Production requires Turnstile, distributed limits, trusted deployment IPs and APP_BASE_URL.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
APP_BASE_URL=http://localhost:3000
ANALYSIS_RATE_LIMIT=10
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=
# Set vercel ONLY behind Vercel's trusted ingress. local is development-only.
TRUSTED_PROXY=local
# Optional future account infrastructure; anonymous checks do not use these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
